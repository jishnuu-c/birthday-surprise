# ==============================================================================
# Birthday Magic — Environment Configuration
# ==============================================================================
# In production (Vercel), add these keys to Project Settings -> Environment Variables.
# For local development, copy this file to `.env` and fill in your Supabase project credentials.
#
# 1. Supabase Project URL:
#    Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anonymous / Public API Key:
#    Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "anon public"
#    Accepted formats:
#      - Modern publishable key (e.g. sb_publishable_...)
#      - Legacy anon JWT key (starts with eyJ... with role: "anon")
#    CRITICAL: Never use the service_role key (sb_secret_... or service_role JWT) in client/Vite variables!
#    The client application will automatically reject and block any service-role keys for security.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-public-key-here

# 3. Server-side Supabase Service Role Key (Used strictly by serverless functions & dev server, never in frontend bundle):
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# 4. Razorpay Payment Gateway Credentials (₹40 per surprise):
#    Found in: Razorpay Dashboard -> Settings -> API Keys
#    Public Key (for frontend checkout modal):
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
#    Server Keys (for cryptographic HMAC SHA-256 & API verification):
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
#    Optional Webhook Secret:
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# 5. Administrator Configuration:
#    The authorized administrator email address(es).
#    Can be a single email or comma-separated list:
#    e.g. VITE_ADMIN_EMAIL=admin@birthdaymagic.com,owner@gmail.com
VITE_ADMIN_EMAIL=admin@birthdaymagic.com
ADMIN_EMAIL=admin@birthdaymagic.com

