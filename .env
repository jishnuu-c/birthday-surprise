# In production (Vercel), add these keys to Project Settings -> Environment Variables.
# For local development, copy this file to `.env` and fill in your Supabase project credentials.
#
# 1. Supabase Project URL:
#    Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://mplgvxraslaqtgjntzpa.supabase.co

# 2. Supabase Anonymous / Public API Key:
#    Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys -> "anon public"
#    IMPORTANT: Never use the service_role key in frontend code or Vite variables.
VITE_SUPABASE_ANON_KEY=sb_publishable_N-D4agXYIn98PMG9w5Ljgg_kam3ly23